# Database
DATABASE_URL=postgresql://user:password@host:5432/database

# Security
JWT_SECRET=your-super-secret-jwt-key-change-me
ADMIN_KEY=your-admin-api-key-change-me

# Email Configuration
EMAIL_SERVICE=gmail
# For Gmail: use gmail, for Mail.ru: use mail.ru, for Yandex: use yandex
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password
EMAIL_FROM=noreply@yourdomain.com

# Custom SMTP (if EMAIL_SERVICE is not gmail/mail.ru/yandex)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false

# Enot.io Payment Gateway
ENOT_SHOP_ID=your_shop_id
ENOT_SECRET_KEY=your_secret_key_1
ENOT_SECRET_KEY_2=your_secret_key_2

# Loader Download URL
LOADER_URL=https://your-cdn.com/loader.exe

# Server
PORT=3000
